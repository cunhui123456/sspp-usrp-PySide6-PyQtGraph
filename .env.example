# 继续使用已有 rf-gnuradio 环境，不创建第二个采集环境。
SSPP_CONDA_ENV=rf-gnuradio
SSPP_DEFAULT_PROFILE=own
SSPP_OWN_PROFILE=Data/device_profiles/own_device_20261008.json
SSPP_TEACHER_PROFILE=local_device.json
# 显示刷新与采集速率彼此独立；完整原始数据照常保存。
SSPP_UI_INTERVAL_MS=100
SSPP_TRACE_INTERVAL_MS=100
SSPP_PREVIEW_INTERVAL_MS=250
SSPP_MAX_DISPLAY_POINTS=20000
